{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
  // OpenCode Quota: loads the server plugin for slash commands and quota checks.
  "plugin": [
    "@slkiser/opencode-quota@latest"
  ],
  "plugins": [
    "@tarquinen/opencode-dcp@latest",
    "@honcho-ai/opencode-honcho",
    "opencode-ntfy-with-questions@latest"
  ],
  "compaction": {
    "auto": false
  },
  "mcp": {
    "servers": {
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      }
    }
  },
  "default_agent": "plan",
  "agents": {
    "build": {
      "model": "openai/gpt-6.1-sol#max"
    },
    "orchestrator": {
      "model": "openai/gpt-6.1-sol#max"
    },
    "plan": {
      "model": "openai/gpt-6.1-sol#max"
    },
    "sidekick": {
      "model": "deepseek/deepseek-flash"
    },
    "explore": {
      "model": "deepseek/deepseek-flash"
    },
    "research": {
      "model": "deepseek/deepseek-flash"
    },
    "design": {
      "model": "alibaba-token-plan/qwen3.8-max#max"
    },
    "reviewer": {
      "model": "openai/gpt-6-astra#medium"
    },
    "config-reviewer": {
      "disabled": true,
      "model": "openai/gpt-6-astra#medium"
    }
  },
  "experimental": {
    "subagent_depth": 2
  },
  "providers": {
    "moonshotai": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
        "kimi-k3": {
          "name": "Kimi K3"
        }
      }
    },
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash"
        }
      }
    },
    "alibaba-token-plan": {
      "models": {
        "qwen3.8-max": {
          "name": "Qwen3.8 Max",
          "variants": [
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "settings": {
            "reasoningEffort": "max",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        },
        "gpt-6-sol": {
          "variants": [
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        },
        "gpt-6.1-sol": {
          "variants": [
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        },
        "gpt-6-astra": {
          "settings": {
            "reasoningEffort": "medium",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          },
          "variants": [
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            }
          ]
        },
        "gpt-5.6-terra": {
          "settings": {
            "reasoningEffort": "max",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        }
      }
    }
  }
}
