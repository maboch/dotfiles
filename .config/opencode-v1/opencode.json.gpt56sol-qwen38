{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "@slkiser/opencode-quota",
    "openrtk",
    "@honcho-ai/opencode-honcho",
    "opencode-ntfy-with-questions"
  ],
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "options": {
        "reasoning_effort": "max"
      },
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "options": {
        "reasoning_effort": "max"
      },
      "permission": {
        "skill": { "brainstorming": "ask" }
      }
    },
    "sidekick": {
      "model": "deepseek/deepseek-v4-flash",
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    },
    "explore": {
      "model": "deepseek/deepseek-v4-flash",
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    },
    "research": {
      "model": "openai/gpt-5.6-terra",
      "options": {
        "reasoning_effort": "max"
      },
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    },
    "design": {
      "model": "alibaba-token-plan/qwen3.8-max",
      "options": {
        "reasoning_effort": "max"
      },
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    },
    "reviewer": {
      "model": "openai/gpt-5.6-sol",
      "options": {
        "reasoning_effort": "max"
      },
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    }
  },
  "experimental": {
    "quotaToast": {
      "enableToast": false,
      "showSessionTokens": true,
      "enabledProviders": "auto",
      "formatStyle": "classic",
      "percentDisplayMode": "remaining"
    }
  },
  "subagent_depth": 2,
  "model": "moonshotai/kimi-k3",
  "small_model": "deepseek/deepseek-v4-flash",
  "provider": {
    "moonshotai": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
        "kimi-k3": {
          "name": "Kimi K3"
        }
      }
    },
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        }
      }
    },
    "alibaba-token-plan": {
      "models": {
        "qwen3.8-max": {
          "name": "Qwen3.8 Max"
        }
      }
    },
    "copilot": {},
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "max",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
          },
        },
        "gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "max",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
          },
        },
      },
    },
    "minimax-coding-plan": {}
  }
}
