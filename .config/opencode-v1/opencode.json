{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    }
  },
  "plugin": [
    "@slkiser/opencode-quota@latest",
    "@tarquinen/opencode-dcp@latest",
    "openrtk",
    "@honcho-ai/opencode-honcho",
    "opencode-ntfy-with-questions@prev"
  ],
  "default_agent": "orchestrator",
  "agent": {
    "build": {
      "model": "openai/gpt-6.1-sol",
      "options": {
        "reasoningEffort": "max"
      },
      "variant": "max",
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    },
    "orchestrator": {
      "model": "openai/gpt-6.1-sol",
      "options": {
        "reasoningEffort": "max"
      },
      "variant": "max",
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    },
    "plan": {
      "model": "openai/gpt-6.1-sol",
      "options": {
        "reasoningEffort": "max"
      },
      "permission": {
        "skill": { "brainstorming": "ask" }
      }
    },
    "sidekick": {
      "model": "deepseek/deepseek-flash",
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    },
    "explore": {
      "model": "deepseek/deepseek-flash",
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    },
    "research": {
      "model": "deepseek/deepseek-flash",
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    },
    "design": {
      "model": "alibaba-token-plan/qwen3.8-max",
      "options": {
        "reasoningEffort": "max"
      },
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    },
    "reviewer": {
      "model": "openai/gpt-6-astra",
      "options": {
        "reasoningEffort": "medium"
      },
      "variant": "medium",
      "permission": {
        "skill": { "brainstorming": "deny" }
      }
    }
  },
  "subagent_depth": 2,
  "model": "moonshotai/kimi-k3",
  "small_model": "deepseek/deepseek-v4-flash",
  "provider": {
    "moonshotai": {
